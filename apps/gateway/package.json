{
  "name": "@tmex/gateway",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "./scripts/run-with-ssh-agent.sh ./scripts/run-rust-gateway.sh",
    "build": "cargo build --locked --release --package tmex-gateway --bin tmex-gateway",
    "start": "./scripts/run-with-ssh-agent.sh ../../target/release/tmex-gateway",
    "test": "cargo test --locked --package tmex-gateway --all-targets && bun test",
    "test:oracle": "bun test",
    "test:ssh-agent-local": "bun test ./src/tmux/ssh-agent-local.integration.ts",
    "test:live:llm": "NODE_ENV=test bun test ./src/llm/provider-live.integration.ts",
    "test:live:llm-api": "NODE_ENV=test bun test ./src/api/llm-api-live.integration.ts",
    "test:live:search": "NODE_ENV=test bun test ./src/agent/tools/web-search-live.integration.ts",
    "test:live:hosted-tool": "NODE_ENV=test bun test ./src/agent/agent-hosted-tool.integration.ts",
    "test:live:weixin": "NODE_ENV=test bun test ./src/weixin/ilink/send-live.integration.ts",
    "test:live": "NODE_ENV=test bun test ./src/llm/provider-live.integration.ts ./src/api/llm-api-live.integration.ts ./src/agent/tools/web-search-live.integration.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.71",
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@tmex/shared": "workspace:*",
    "ai": "^6.0.203",
    "drizzle-orm": "^0.45.1",
    "ghostty-terminal": "workspace:*",
    "gramio": "^0.4.12",
    "i18next": "^25.8.5",
    "ssh2": "^1.16.0",
    "uuid": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ssh2": "^1.15.4",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.7.3"
  }
}
